# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=identity_db
DB_USER=postgres
DB_PASSWORD=

# --- Identity Service ---
SERVER_PORT=8081
IDENTITY_SERVICE_URL=http://localhost:8081
JWT_SECRET=your-secret-key
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
REQUIRE_EMAIL_VERIFICATION=true

# --- Email (SMTP) ---
EMAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@localhost
EMAIL_FRONTEND_BASE_URL=http://localhost:4200
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MS=3600000

# --- Dev Mode ---
DEV_INCLUDE_VERIFICATION_TOKEN_IN_RESPONSE=true

# --- Kafka (optional) ---
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_IDENTITY_EVENTS=identity.events
OUTBOX_RELAY_FIXED_DELAY_MS=10000
OUTBOX_RELAY_BATCH_SIZE=50

# --- Admin Seed ---
identity.admin.email=
identity.admin.password=
identity.admin.first-name=
identity.admin.last-name=
